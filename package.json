{
  "name": "@sovara/pi",
  "version": "0.1.2",
  "description": "Sovara tracing and lesson retrieval for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SovaraLabs/pi-sovara.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "sovara",
    "observability"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "bootstrap:sdk": "node scripts/bootstrap-sdk.mjs",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check",
    "test:package": "node scripts/test-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/SovaraLabs/pi-sovara#readme",
  "bugs": {
    "url": "https://github.com/SovaraLabs/pi-sovara/issues"
  },
  "dependencies": {
    "@sovara/sdk": "0.8.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
